# KBase on CML: the settings profile.
# Read by scripts/cml/app.py (the Application) and scripts/cml/install.py. Anything already set in the
# CML project's environment variables wins over this file, so put keys there, never here.
# Relative paths are from the KBase folder.

# ---- App and the controls database ----
APP_MODE=demo
DATA_DIR=var/cml
# Staff, folders, grants, approvals, audit and chunk records stay in SQLite, as in the project design
# (docs/infrastructure.md); Garage holds the files. Postgres also works:
# DATABASE_URL=postgresql+psycopg://user@host:5432/kbase (password in the project's environment).
DATABASE_URL=sqlite:///var/cml/kbase.db
# The project disk is a network file system: WAL is not safe there.
SQLITE_JOURNAL_MODE=delete
INGEST_WORKERS=1
KB_TELEMETRY_ENABLED=false
LOCAL_INGESTION_ENABLED=false

# ---- Files: Garage (S3-compatible) ----
STORAGE_BACKEND=s3
S3_BUCKET=abc-knowledge
AWS_REGION=garage
S3_ADDRESSING_STYLE=path
# Garage started by app.py inside the Application, on its own loopback address (KB_CML_GARAGE_CONFIG
# below). Plain HTTP and serialized writes are allowed only for loopback.
S3_ENDPOINT_URL=http://127.0.0.1:3900
S3_ALLOW_INSECURE_HTTP=true
S3_WRITE_MODE=serialized-local
# A Garage server already running elsewhere instead: its HTTPS origin, its s3_region, verified TLS,
# and leave KB_CML_GARAGE_CONFIG blank:
# S3_ENDPOINT_URL=https://garage.example:3900
# S3_ALLOW_INSECURE_HTTP=false
# S3_WRITE_MODE=conditional
# S3_CA_BUNDLE=/path/to/ca.pem
# The access key goes in the project's environment: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY.
AWS_EC2_METADATA_DISABLED=true

# ---- OpenSearch: keyword and vector search ----
SEARCH_BACKEND=opensearch
SEARCH_ENGINE=opensearch
# OpenSearch started by app.py inside the Application (KB_CML_OPENSEARCH_HOME below) uses this address.
# The bank's cluster instead: its https URL, an account and its CA certificate.
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=kbase-cml-v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_CA_CERTS=
OPENSEARCH_VECTOR_SEARCH=true
OPENSEARCH_BM25_FALLBACK_INDEX=
OPENSEARCH_HYBRID_FOLDERS=[]

# ---- Models: every model but GLiNER on the bank's endpoints ----
# Plain OpenAI-compatible requests to internal servers.
MODEL_API=openai
EXTERNAL_MODELS_ENABLED=true
ALLOW_UNMASKED_EXTERNAL=false
GUARDRAILS_ENABLED=true
LLM_PROVIDER=api
EMBEDDING_BACKEND=api
# Must match the embedding model's vector size; a change needs a new OPENSEARCH_INDEX.
EMBEDDING_DIMENSIONS=384
# For each model: its name, and its link (base URL such as https://host/model/v1, HTTPS only).
# The keys go in the project's environment: ANSWER_MODEL_KEY, VISION_MODEL_KEY, EMBEDDING_MODEL_KEY, ...
ANSWER_MODEL=
ANSWER_MODEL_URL=
# Blank planner and guardrail: the answer model and its link.
PLANNER_MODEL=
PLANNER_MODEL_URL=
GUARDRAIL_MODEL=
GUARDRAIL_MODEL_URL=
VISION_MODEL=
VISION_FALLBACK_MODEL=
VISION_MODEL_URL=
EMBEDDING_MODEL=
EMBEDDING_MODEL_URL=
IMAGE_EMBEDDINGS_ENABLED=false
# PDF charts and scanned regions go to VISION_MODEL.
PDF_VISION_ENABLED=true
ALLOW_EXTERNAL_VISION_IMAGES=true

# ---- Parsing: Docling runs locally in the Application ----
PDF_PARSER=docling_local
IMAGE_PARSER=docling_local
DOCLING_OCR=true
# Charts are read by VISION_MODEL over its endpoint, not by Granite on this machine.
GRANITE_CHARTS=false
# Workers use -P: pip installs packages into the user folder in a CML session, which -I would ignore.
KB_WORKER_PYTHON_FLAG=-P

# ---- Knowledge graph and entity scan: GLiNER2.5, locally ----
KBASE_GRAPH_EXTRACTOR=gliner

# ---- Model files on disk (GLiNER, Docling layout and tables), uploaded into the project ----
HF_HOME=models/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ---- What app.py starts before KBase ----
# Garage: its private config (see garage.toml.example) and binary. Blank or off: use S3_ENDPOINT_URL as is.
KB_CML_GARAGE_CONFIG=var/garage/config.toml
KB_CML_GARAGE_BIN=tools/garage
# OpenSearch: the folder of the unpacked Linux tarball. Blank or off: use OPENSEARCH_URL as is.
KB_CML_OPENSEARCH_HOME=tools/opensearch
KB_CML_OPENSEARCH_HEAP=1g
# 1 starts with a warning when the index is not fully verified yet (serve --partial-corpus).
KB_CML_PARTIAL_CORPUS=0
