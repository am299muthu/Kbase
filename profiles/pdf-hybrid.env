# All new ingestion: native text/tables + PDF VL interpretations + text embeddings.
# Existing legacy generations remain readable until individually reprocessed.
LLM_PROVIDER=openrouter
EXTERNAL_MODELS_ENABLED=true
EMBEDDING_BACKEND=openrouter
OPENSEARCH_INDEX=abc-kb-curated-multimodal-v2
OPENSEARCH_VECTOR_SEARCH=true
OPENSEARCH_BM25_FALLBACK_INDEX=abc-kb-curated-v1
# Historical initial-batch metadata retained for existing approval fingerprints.
OPENSEARCH_HYBRID_FOLDERS=["pdf-pilot"]
PDF_VISION_ENABLED=true
ALLOW_EXTERNAL_VISION_IMAGES=true
IMAGE_EMBEDDINGS_ENABLED=false
ALLOW_UNMASKED_EXTERNAL=false
GUARDRAILS_ENABLED=true
STORAGE_BACKEND=s3
