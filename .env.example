# Copy to .env. All relative paths resolve against the project directory.
APP_NAME=ABC Knowledge
APP_MODE=demo
# Named routing/gate profile; credentials and model IDs stay in private .env.
# Use hybrid only after S3, checker approvals, corpus population and profile-check.
KB_RUNTIME_PROFILE=local
HOST=127.0.0.1
PORT=8000
DATA_DIR=var
CORPUS_DIR=KM_Data
DATABASE_URL=sqlite:///var/kbase.db
# SQLite may hold staff/access/structured controls in either mode.
# Optional PostgreSQL: postgresql+psycopg://kb:CHANGE_ME@localhost:5432/kbase
# Optional standalone diagnostics; does not change the app's database backend.
POSTGRES_HEALTH_URL=
HEALTH_APP_URL=http://127.0.0.1:8000
SEARCH_BACKEND=opensearch
STORAGE_BACKEND=local
# Infrastructure: SEARCH_BACKEND=opensearch, STORAGE_BACKEND=s3, APP_MODE=infrastructure
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=abc-kb-curated-v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
# Set to the trusted local/enterprise CA file for HTTPS; never disable verification.
OPENSEARCH_CA_CERTS=
# KB search remains BM25 until a real embedding model and new vector index are provisioned.
# This host has verified Lucene float32 k-NN; see docs/opensearch-arm64-plugins.md.
# Enable only with k-NN + a validated embedding model, then create a new index/reindex.
OPENSEARCH_VECTOR_SEARCH=false
# Blank endpoint uses AWS S3; set an approved HTTPS origin for another provider.
S3_ENDPOINT_URL=
S3_BUCKET=abc-knowledge
# Blank credentials use the AWS SDK credential chain; never use test placeholders.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1
S3_ADDRESSING_STYLE=auto
S3_CA_BUNDLE=
S3_ALLOW_INSECURE_HTTP=false
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=60
S3_MAX_ATTEMPTS=3
# Only use serialized-local for explicitly approved loopback storage without conditional PUT.
S3_WRITE_MODE=conditional
# Set a strong unique password before first seed. Demo users share it ONLY locally.
DEMO_PASSWORD=local-demo-change-me
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
MAX_UPLOAD_MB=30
RETENTION_YEARS=7
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP=200
RETRIEVAL_K=5
EMBEDDING_DIMENSIONS=384
# Hash embeddings are an offline smoke-test aid, not semantic production embeddings.
EMBEDDING_BACKEND=hash
# Image vectors use a separate model/space and require a fresh multimodal index.
IMAGE_EMBEDDINGS_ENABLED=false
OPENROUTER_IMAGE_EMBEDDING_MODEL=
IMAGE_EMBEDDING_DIMENSIONS=0
# Pixel upload requires separate approval: text masking does not redact image PII.
PDF_VISION_ENABLED=false
# Scanned/sparse/raster-dominant pages are read with VL, not dependent on Tesseract.
# Overlapping regions collectively cover the page and need explicit image-transfer review.
PDF_SCANNED_VL_ENABLED=true
PDF_SCAN_TILE_OVERLAP=0.08
GUARDRAILS_ENABLED=true
# Blank uses OPENROUTER_MODEL; the guardrail detector also processes external text.
OPENROUTER_GUARDRAIL_MODEL=
GUARDRAIL_MAX_CHARS=16000
GUARDRAIL_MAX_ENTITIES=500
ALLOW_EXTERNAL_VISION_IMAGES=false
VISION_MAX_IMAGE_BYTES=5242880
VISION_MAX_IMAGE_PIXELS=4000000
VISION_MAX_PAGE_FRACTION=0.8
LLM_PROVIDER=extractive
# Set BOTH gates only after approving external processing of the document corpus.
EXTERNAL_MODELS_ENABLED=false
ALLOW_UNMASKED_EXTERNAL=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai
OPENROUTER_CHAT_PATH=/api/v1/chat/completions
OPENROUTER_EMBEDDING_PATH=/api/v1/embeddings
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
OPENROUTER_VISION_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
LLM_TEMPERATURE=0
I_RETRY=1
E_RETRY=1
MODEL_TIMEOUT_SECONDS=90
# docling_hybrid = pypdf text + pdfplumber ruled tables + Docling visual objects.
PDF_PARSER=pypdf
# 0 disables the PDF visual-object count cap.
PARSER_MAX_PDF_OBJECTS=0
OCR_ENABLED=false
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=60
PARSER_MAX_FILE_BYTES=134217728
PARSER_MAX_TEXT_CHARS=20000000
PARSER_MAX_IMAGE_PIXELS=40000000
PARSER_MAX_CELLS=1000000
# Optional docling PDF mode requires locally preprovisioned weights:
DOCLING_ARTIFACTS_PATH=

# Local authenticated TLS OTLP receivers; provision with scripts/setup_data_prepper.py.
KB_TELEMETRY_ENABLED=false
# KB_TELEMETRY_CONFIG=/absolute/path/to/var/telemetry/client.json

# --- Model fallback chains (2026-11-04) ---
# OPENROUTER_MODEL, OPENROUTER_GUARDRAIL_MODEL and OPENROUTER_VISION_MODEL accept comma-separated lists.
# ':free' models are always tried first; non-free models are used only after all free ones fail.
# OPENROUTER_VISION_FALLBACK_MODEL is appended to the vision chain. Authentication errors stop the chain.
# OPENROUTER_EMBEDDING_MODEL must be ONE model (vectors from different models cannot share a field).
# Paid models need explicit ceilings in USD per million tokens; 0 disables paid models.
OPENROUTER_PAID_MAX_PRICE_PROMPT=0
OPENROUTER_PAID_MAX_PRICE_COMPLETION=0
# qwen/qwen3-embedding-8b: native 4096 dimensions (MRL 32-4096); set EMBEDDING_DIMENSIONS=4096 and use a new index.
